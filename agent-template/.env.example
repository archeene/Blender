# Copy to .env and fill in.
# .env is mounted to /root/.hermes/.env inside the Modal container via the
# `hermes-secrets` Modal Secret.

# OpenRouter API key for the free Hermes 3 405B tier (rate-limited).
# Sign up at https://openrouter.ai/ and create a key.
OPENROUTER_API_KEY=

# Optional: if you want a fallback paid model, set a Together / Anthropic
# / OpenAI key here. Hermes Agent reads provider precedence from config.yaml.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# TOGETHER_API_KEY=
