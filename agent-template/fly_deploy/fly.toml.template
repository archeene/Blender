# Fly.io app config template for a Blender offspring.
# spawn_offspring.py renders this for each offspring with the agent's name
# substituted into APP_NAME and VOLUME_NAME.

app = "{{app_name}}"
primary_region = "ord"

[build]
dockerfile = "Dockerfile"

[env]
HERMES_UID = "10000"
HERMES_GID = "10000"
HERMES_HOME = "/opt/data"
API_SERVER_ENABLED = "true"
API_SERVER_HOST = "0.0.0.0"
API_SERVER_PORT = "8642"

[[mounts]]
source = "{{volume_name}}"
destination = "/opt/data"
initial_size = "5gb"

[[vm]]
memory = "2gb"
cpu_kind = "shared"
cpus = 1

[http_service]
internal_port = 8642
force_https = true
auto_stop_machines = "off"
auto_start_machines = true
min_machines_running = 1
processes = ["app"]

# Hermes Agent's gateway exposes /health on API_SERVER_PORT once the API
# server platform finishes initializing. Cold-start time depends on cron
# count, MCP server spawning, and the `gl register` network call in
# entrypoint.sh. The yield-aggregator first deploy (2026-05-19) reported
# `critical` with grace_period=60s; 240s gives margin for a 12-cron +
# 7-MCP + DID-registration cold start.
[[http_service.checks]]
interval = "30s"
timeout = "5s"
grace_period = "240s"
method = "GET"
path = "/health"

[deploy]
strategy = "immediate"

# Required secrets to set before first deploy:
#   flyctl secrets set --app {{app_name}} \
#     GLM_API_KEY=...         # Z.ai / Zhipu GLM key (the agent's brain)
#     GLM_BASE_URL=...        # GLM endpoint, usually https://open.bigmodel.cn/api/paas/v4
#     BANKR_API_KEY=...       # for the bankr-mcp wrapper
#     NEYNAR_API_KEY=...      # for the farcaster-post MCP (optional)
#     NEYNAR_SIGNER_UUID=...  # for posting (optional)
#     GITHUB_TOKEN=...        # for the publish_profile skill (optional)
#     API_SERVER_KEY=...      # gateway access key
