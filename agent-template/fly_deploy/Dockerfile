# Lightweight Dockerfile for spawning a Blender offspring on Fly.io.
#
# Builds on the official Hermes Agent pattern but uses pip-installed
# hermes-agent rather than the full source build (faster image, easier to
# reproduce). For Gen 0 / Blender-itself, use the full hermes-agent source
# repo's Dockerfile instead (mirrors the existing blender-agent app).
#
# Each offspring gets its own image, app, and 5GB Volume. spawn_offspring.py
# generates a per-offspring deploy directory with this Dockerfile.

FROM python:3.13-slim AS base

ENV PYTHONUNBUFFERED=1 \
    HERMES_HOME=/opt/data \
    PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright

# System deps for hermes-agent (browser automation, git, common tools).
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates gnupg git tini procps ripgrep ffmpeg \
        build-essential python3-dev libffi-dev nodejs npm sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Non-root user; UID overridable via HERMES_UID at runtime.
RUN useradd -u 10000 -m -d /opt/data hermes

# Install hermes-agent and MCP SDK.
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir hermes-agent "mcp>=1.2.0"

# Pre-pull clawnch-mcp-server so the first MCP call doesn't pay the npx
# install latency. Pinned to ^1 to allow safe minor updates. The npm package
# is named `clawnch-mcp-server` but installs the binary as `clawnch-mcp`.
RUN npm install -g "clawnch-mcp-server@^1" \
    && which clawnch-mcp

# Install gitlawb CLI (gl + git-remote-gitlawb) for did:gitlawb identity,
# MCP server, and decentralized repo ops. The installer supports
# GITLAWB_INSTALL_DIR so we drop the binaries directly on PATH.
# v0.1.0-alpha — pin a specific version once the project stabilizes.
RUN curl -fsSL https://gitlawb.com/install.sh | GITLAWB_INSTALL_DIR=/usr/local/bin sh \
    && gl --version

# Optional: install playwright browsers for the browser-automation skill.
# Comment out if you do not need browser-based Farcaster posting / scraping.
RUN python -m playwright install --with-deps chromium 2>/dev/null || \
    echo "[build] playwright install skipped; agent will use API-only skills"

WORKDIR /opt/hermes

# ---- offspring-specific files ----
# These come from the agent's deploy directory generated by spawn_offspring.py.
# All paths land under /opt/data (the persistent Fly Volume) on first boot;
# subsequent boots use whatever is already in the volume.

COPY --chown=hermes:hermes config.yaml /opt/hermes/config.yaml
COPY --chown=hermes:hermes SOUL.md /opt/hermes/SOUL.md
COPY --chown=hermes:hermes MEMORY.md /opt/hermes/MEMORY.md
COPY --chown=hermes:hermes USER.md /opt/hermes/USER.md
COPY --chown=hermes:hermes cron_jobs.json /opt/hermes/cron_jobs.json
COPY --chown=hermes:hermes bootstrap_crons.py /opt/hermes/bootstrap_crons.py
COPY --chown=hermes:hermes mcp/ /opt/hermes/mcp/
COPY --chown=hermes:hermes skills/ /opt/hermes/skills/
COPY --chown=hermes:hermes templates/ /opt/hermes/templates/

# Entrypoint: copy defaults into the volume on first boot, run bootstrap, start gateway.
COPY --chmod=0755 entrypoint.sh /usr/local/bin/entrypoint.sh

EXPOSE 8642
ENTRYPOINT ["tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["hermes", "gateway", "run"]
